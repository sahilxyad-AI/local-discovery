# LocalConnect Environment Variables Configuration
PORT=5000
NODE_ENV=development

# Optional LLM Provider Key (Defaults to High-Precision Local NLU Engine if not provided)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Database configuration (for PostgreSQL production deployment)
DATABASE_URL=postgresql://postgres:password@localhost:5432/localconnect_db

# JWT Secret
JWT_SECRET=localconnect_super_secret_jwt_key_2024
